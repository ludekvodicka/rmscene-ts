{
  "name": "rmscene-ts",
  "version": "0.1.0",
  "description": "Read, write, and render reMarkable .rm version 6 files in TypeScript",
  "keywords": [
    "remarkable",
    "rm",
    "scene",
    "typescript"
  ],
  "homepage": "https://github.com/ludekvodicka/rmscene-ts#readme",
  "bugs": {
    "url": "https://github.com/ludekvodicka/rmscene-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludekvodicka/rmscene-ts.git"
  },
  "author": "Ludek Vodicka",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/create-cjs-declarations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node tests/package/esm.mjs && node tests/package/cjs.cjs && tsc -p tsconfig.package.json && publint",
    "check": "npm run typecheck && npm run test && npm run test:package",
    "goldens": "python scripts/regenerate-goldens.py --rmscene ../rmscene",
    "goldens:writer": "python scripts/regenerate-writer-goldens.py --rmscene ../rmscene",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "fast-check": "^4.9.0",
    "publint": "^0.3.23",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
